<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Register</title>
  <link rel="stylesheet" href="/admin/css/admin-signup.css">
</head>

<body>

<!-- HEADER -->
<header class="navbar">
  <div class="nav-left">
    <span class="menu">☰</span>
    <a href="#">Home</a>
    <a href="#">Shop</a>
  </div>

  <div class="nav-center">BLUNT</div>

  <div class="nav-right">
    <span>🔍</span>
    <span>👤</span>
    <span>🛒</span>
  </div>
</header>

<!-- MAIN -->
<div class="container">

  <h3 class="account-title">Admin Account</h3>

  <div class="card">
    <h4>Register</h4>

    <form action="/admin/signup" method="POST">

      <label>Email Address *</label>
      <input type="email" name="email" required>

      <p class="privacy">privacy policy</p>
      <button type="submit" class="btn">Register</button>

      <p class="login-link">
        Already have an account?
        <a href="/admin/login">Login here</a>
      </p>

    </form>
  </div>

</div>

<script src="/js/admin-signup.js"></script>

</body>
</html>