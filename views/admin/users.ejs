<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Users</title>
  <link rel="stylesheet" href="/admin/css/admin-dashboard.css">
</head>

<body>

<div class="dashboard">

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <h2 class="logo">BLUNT</h2>

    <ul>
      <li>Dashboard</li>
      <li class="active">Users</li>
      <li>Products</li>
      <li>Categories</li>
      <li>Orders</li>
    </ul>

    <a href="/admin/logout" class="logout">Logout</a>
  </aside>

  <!-- MAIN -->
  <main class="main">

    <!-- TOPBAR -->
    <div class="topbar">
      <input type="text" placeholder="Search orders,Products..." />
      <div class="admin-info">
        Admin
      </div>
    </div>

    <!-- CONTENT -->
    <div class="content">

      <h2>Users</h2>

      <!-- SEARCH -->
      <form method="GET" action="/admin/users" class="search-box">
        <input 
          type="text" 
          name="search" 
          value="<%= search %>" 
          placeholder="Search users..."
        >
        <button>Search</button>
        <a href="/admin/users" class="clear">Clear</a>
      </form>

      <!-- TABLE -->
      <table>
        <thead>
          <tr>
            <th>Email</th>
            <th>Status</th>
            <th>Join Date</th>
            <th>Action</th>
          </tr>
        </thead>

        <tbody>
          <% users.forEach(user => { %>
            <tr>
              <td><%= user.email %></td>

              <td>
                <span class="<%= user.isBlocked ? 'badge red' : 'badge green' %>">
                  <%= user.isBlocked ? 'Blocked' : 'Active' %>
                </span>
              </td>

              <td>
                <%= new Date(user.createdAt).toDateString() %>
              </td>

              <td>
                <form action="/admin/block-user/<%= user._id %>?_method=PATCH" method="PATCH">
                  <button 
  type="button"
  class="action-btn"
  onclick="openBlockModal(`<%= user._id %>`, `<%= user.isBlocked ? 'Unblock' : 'Block' %>`)"
>
  <%= user.isBlocked ? "Unblock" : "Block" %>
</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>

    <!-- BLOCK CONFIRM MODAL -->
<div id="blockModal" class="modal">
  <div class="modal-box">

    <h3 id="modalTitle">Confirm Action</h3>
    <p id="modalMessage"></p>

    <div class="modal-actions">
      <button class="modal-cancel" onclick="closeModal()">Cancel</button>
      <button class="modal-confirm" onclick="confirmBlock()">Confirm</button>
    </div>

  </div>
</div>

      <!-- PAGINATION -->
      <div class="pagination">
        <% for(let i=1;i<=totalPages;i++){ %>
          <a 
            href="/admin/users?page=<%= i %>&search=<%= search %>"
            class="<%= currentPage === i ? 'active-page' : '' %>"
          >
            <%= i %>
          </a>
        <% } %>
      </div>

    </div>

  </main>

</div>

<!-- CONFIRM SCRIPT -->
<script>
function confirmAction(action) {
  return confirm(`Are you sure you want to ${action} this user?`);
}
</script>

<script>

let selectedUserId = null;
let selectedAction = null;

function openBlockModal(userId, action){
  selectedUserId = userId;
  selectedAction = action;

  document.getElementById("modalMessage").innerText =
    `Are you sure you want to ${action} this user?`;

  document.getElementById("blockModal").style.display = "flex";
}

function closeModal(){
  document.getElementById("blockModal").style.display = "none";
}

function confirmBlock(){
  window.location.href = `/admin/block-user/${selectedUserId}?_method=PATCH`;
}

</script>

</body>
</html>