<!-- Cropper.js CSS -->
<link href="https://unpkg.com/cropperjs/dist/cropper.min.css" rel="stylesheet">
<!-- Cropper.js JS -->
<script src="https://unpkg.com/cropperjs/dist/cropper.min.js"></script>


<div class="page-header">
  <h2>Edit Product</h2>
  <p>Update product details and images</p>
</div>

<div class="form-card">
  <form id="editProductForm">
    <div class="form-grid">
      <div class="form-group full-width">
        <label for="name">Product Name <span style="color:#ef4444">*</span></label>
        <input type="text" id="name" name="name" class="form-control" value="<%= product.name %>">
        <div class="error-msg" id="nameError"></div>
      </div>

      <div class="form-group full-width">
        <label for="description">Description <span style="color:#ef4444">*</span></label>
        <textarea id="description" name="description" class="form-control"><%= product.description %></textarea>
        <div class="error-msg" id="descError"></div>
      </div>

      <div class="form-group">
        <label for="category">Category <span style="color:#ef4444">*</span></label>
        <select id="category" name="category" class="form-control">
          <% categories.forEach(cat=> { %>
            <option value="<%= cat._id %>" <%=product.category.toString()===cat._id.toString() ? 'selected' : '' %>><%=
                cat.name %>
            </option>
            <% }) %>
        </select>
        <div class="error-msg" id="catError"></div>
      </div>

      <div class="form-group">
        <label for="price">Price ($) <span style="color:#ef4444">*</span></label>
        <input type="number" id="price" name="price" class="form-control" step="0.01" min="0"
          value="<%= product.price %>">
        <div class="error-msg" id="priceError"></div>
      </div>

      <div class="form-group">
        <label for="stock">Stock Quantity <span style="color:#ef4444">*</span></label>
        <input type="number" id="stock" name="stock" class="form-control" min="0" value="<%= product.stock %>">
        <div class="error-msg" id="stockError"></div>
      </div>

      <div class="form-group full-width">
        <label>Product Images <span style="color:#ef4444">*</span></label>
        <div class="upload-area">
          <input type="file" id="imageInput" accept="image/*" multiple>
          <div class="upload-icon"><i class="bi bi-cloud-arrow-up"></i></div>
          <div class="upload-text">Click or drag images to upload</div>
          <div class="upload-hint">Upload more images. Ensure a total of 3 images minimum visually.</div>
        </div>
        <div class="error-msg" id="imageError"></div>

        <div class="preview-container" id="previewContainer">
          <!-- Existing Images populated by JS -->
        </div>
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn-submit" id="submitBtn">Save Changes</button>
      <a href="/admin/products" class="btn-cancel">Cancel</a>
    </div>
  </form>
</div>

<!-- Cropper Modal -->
<div class="cropper-modal" id="cropperModal">
  <div class="cropper-content">
    <h3 style="margin-top: 0; margin-bottom: 12px; font-size: 1.1rem;">Crop Image</h3>
    <div class="cropper-wrapper">
      <img id="cropperImage" src="" style="max-width: 100%; display: block;">
    </div>
    <div class="cropper-actions">
      <button type="button" class="btn-cancel" onclick="cancelCrop()" style="padding: 8px 16px;">Cancel</button>
      <button type="button" class="btn-crop" id="cropBtn">Crop & Save</button>
    </div>
  </div>
</div>

<script>
  // Initial state passed from EJS
  let existingImages = <%- JSON.stringify(product.images || []) %>;
  let croppedFiles = []; // Array of new { file, url }

  let currentFile = null;
  let cropper = null;

  const imageInput = document.getElementById('imageInput');
  const previewContainer = document.getElementById('previewContainer');
  const cropperModal = document.getElementById('cropperModal');
  const cropperImage = document.getElementById('cropperImage');
  const editProductForm = document.getElementById('editProductForm');
  const submitBtn = document.getElementById('submitBtn');

  let fileQueue = [];
  let isCropping = false;

  // Initialize previews on load
  renderPreviews();

  // Handle File Selection
  imageInput.addEventListener('change', function (e) {
    if (this.files && this.files.length > 0) {
      for (let i = 0; i < this.files.length; i++) {
        fileQueue.push(this.files[i]);
      }
      processQueue();
    }
    this.value = '';
  });

  function processQueue() {
    if (isCropping || fileQueue.length === 0) return;
    isCropping = true;
    currentFile = fileQueue.shift();

    const reader = new FileReader();
    reader.onload = function(e) {
      console.log("File read complete");
      
      // Attach onload handler BEFORE setting src
      cropperImage.onload = function() {
        console.log("Image element loaded");
        cropperModal.classList.add('show');
        
        // Ensure modal is visible and dimensions are ready
        setTimeout(() => {
          if (typeof Cropper === 'undefined') {
            alert('CropperJS library failed to load. Please check your internet connection.');
            return;
          }
          if (cropper) cropper.destroy();
          cropper = new Cropper(cropperImage, {
            aspectRatio: 1,
            viewMode: 1,
            autoCropArea: 1,
            background: false,
            responsive: true,
          });
          console.log("Cropper initialized successfully");
        }, 120);
      };
      cropperImage.src = e.target.result;
    };
    reader.readAsDataURL(currentFile);
  }

  document.getElementById('cropBtn').addEventListener('click', function () {
    if (!cropper) return;
    const canvas = cropper.getCroppedCanvas({ width: 800, height: 800 });
    canvas.toBlob((blob) => {
      const url = URL.createObjectURL(blob);
      const uniqueName = Date.now() + '-' + currentFile.name;
      const finalFile = new File([blob], uniqueName, { type: 'image/jpeg' });

      croppedFiles.push({ file: finalFile, url: url });
      renderPreviews();
      closeCropper();
    }, 'image/jpeg', 0.9);
  });

  function cancelCrop() { closeCropper(); }

  function closeCropper() {
    cropperModal.classList.remove('show');
    if (cropper) cropper.destroy();
    cropper = null;
    isCropping = false;
    processQueue();
  }

  function renderPreviews() {
    previewContainer.innerHTML = '';

    // Render existing DB images
    existingImages.forEach((imgSrc, index) => {
      const div = document.createElement('div');
      div.className = 'preview-item';
      div.innerHTML = `
        <img src="${imgSrc}" alt="Saved image">
        <div class="existing-badge">Saved</div>
        <button type="button" class="remove-btn" onclick="removeExistingImage(${index})">&times;</button>
      `;
      previewContainer.appendChild(div);
    });

    // Render new uploaded/cropped images
    croppedFiles.forEach((item, index) => {
      const div = document.createElement('div');
      div.className = 'preview-item';
      div.innerHTML = `
        <img src="${item.url}" alt="New Preview">
        <div class="existing-badge" style="background: #10b981;">New</div>
        <button type="button" class="remove-btn" onclick="removeNewImage(${index})">&times;</button>
      `;
      previewContainer.appendChild(div);
    });
  }

  window.removeExistingImage = function (index) {
    existingImages.splice(index, 1);
    renderPreviews();
  };

  window.removeNewImage = function (index) {
    URL.revokeObjectURL(croppedFiles[index].url);
    croppedFiles.splice(index, 1);
    renderPreviews();
  };

  // Submission
  editProductForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    document.querySelectorAll('.error-msg').forEach(el => el.style.display = 'none');

    const name = document.getElementById('name').value.trim();
    const description = document.getElementById('description').value.trim();
    const category = document.getElementById('category').value;
    const price = document.getElementById('price').value;
    const stock = document.getElementById('stock').value;

    let hasError = false;
    if (!name) { document.getElementById('nameError').textContent = 'Required'; document.getElementById('nameError').style.display = 'block'; hasError = true; }
    if (!description) { document.getElementById('descError').textContent = 'Required'; document.getElementById('descError').style.display = 'block'; hasError = true; }
    if (!price || Number(price) < 0) { document.getElementById('priceError').textContent = 'Invalid price'; document.getElementById('priceError').style.display = 'block'; hasError = true; }
    if (!stock || Number(stock) < 0) { document.getElementById('stockError').textContent = 'Invalid stock'; document.getElementById('stockError').style.display = 'block'; hasError = true; }

    const totalCount = existingImages.length + croppedFiles.length;
    if (totalCount < 3) {
      document.getElementById('imageError').textContent = 'Must have at least 3 images total.';
      document.getElementById('imageError').style.display = 'block';
      hasError = true;
    }

    if (hasError) return;

    const formData = new FormData();
    formData.append('name', name);
    formData.append('description', description);
    formData.append('category', category);
    formData.append('price', price);
    formData.append('stock', stock);

    // Append existing image paths (so backend knows what to keep/delete)
    existingImages.forEach(img => formData.append('existingImages', img));

    // Append new files
    croppedFiles.forEach(item => formData.append('images', item.file));

    submitBtn.textContent = 'Saving...';
    submitBtn.disabled = true;

    try {
      const res = await axios.post('/admin/products/edit/<%= product._id %>', formData, {
        headers: {
          'Content-Type': 'multipart/form-data'
        }
      });
      window.location.href = res.data.redirectUrl;
    } catch (err) {
      document.getElementById('imageError').textContent = err.response?.data?.message || 'Update failed.';
      document.getElementById('imageError').style.display = 'block';
      submitBtn.textContent = 'Save Changes';
      submitBtn.disabled = false;
    }
  });
</script>