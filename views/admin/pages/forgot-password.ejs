<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Forgot Password | Blunt Admin</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"/>
  <link rel="stylesheet" href="/admin/css/admin-auth.css"/>
</head>
<body>

  <div class="brand">
    <i class="brand-icon">ℹ</i>
    <span class="brand-name">BLUNT Admin Panel</span>
  </div>

  <div class="card">
    <h2>Forgot Password</h2>
    <p>Enter your email address to receive an OTP.</p>

    <div id="alertBox" class="alert"></div>

    <div class="form-group">
      <label for="email">Email Address</label>
      <input type="email" id="email" placeholder="Enter your email"/>
      <div class="field-error" id="emailError">Enter a valid email address</div>
    </div>

    <button class="btn" id="sendBtn">
      <span id="btnText">Send OTP</span>
      <div class="spinner" id="spinner"></div>
    </button>

    <a href="/admin/login" class="back-link">← Return to Sign In</a>
  </div>

<script>
  document.getElementById('sendBtn').addEventListener('click', async () => {
    const email = document.getElementById('email').value.trim();
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    document.getElementById('email').classList.remove('error');
    document.getElementById('emailError').classList.remove('show');
    document.getElementById('alertBox').classList.remove('show');

    if (!email || !emailRegex.test(email)) {
      document.getElementById('email').classList.add('error');
      document.getElementById('emailError').classList.add('show');
      return;
    }

    setLoading(true);

    try {
      const res = await axios.post('/admin/forgot-password', { email });
      showAlert(res.data.message, 'success');
      setTimeout(() => window.location.href = res.data.redirectUrl, 1000);
    } catch (err) {
      showAlert(err.response?.data?.message || 'Something went wrong');
    } finally {
      setLoading(false);
    }
  });

  function setLoading(val) {
    document.getElementById('sendBtn').disabled = val;
    document.getElementById('btnText').textContent = val ? 'Sending...' : 'Send OTP';
    document.getElementById('spinner').classList.toggle('show', val);
  }

  function showAlert(msg, type = 'error') {
    const box = document.getElementById('alertBox');
    box.textContent = msg;
    box.className = `alert alert-${type} show`;
  }
</script>
</body>
</html>
