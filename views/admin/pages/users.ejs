
<!-- Page Header -->
<div class="page-header">
  <h2>Users</h2>
  <p>Manage your customer base</p>
</div>

<!-- Card -->
<div class="users-card">

  <!-- Toolbar -->
  <form class="toolbar" method="GET" action="/admin/users" id="searchForm">
    <div class="search-box">
      <i class="bi bi-search"></i>
      <input
        type="text"
        name="search"
        id="searchInput"
        placeholder="Search users..."
        value="<%= search %>"
        autocomplete="off"
      />
    </div>
    <div class="toolbar-actions">
      <button type="submit" class="btn-search">Search</button>
      <% if (search) { %>
        <a href="/admin/users" class="btn-clear">
          <i class="bi bi-x"></i> Clear
        </a>
      <% } %>
    </div>
  </form>

  <!-- Table -->
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>User</th>
          <th>Contact</th>
          <th>Orders</th>
          <th>Total Spent</th>
          <th>Join Date</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (users.length === 0) { %>
          <tr>
            <td colspan="7">
              <div class="empty-state">
                <i class="bi bi-person-slash"></i>
                <p>No users found<% if (search) { %> for "<strong><%= search %></strong>"<% } %></p>
              </div>
            </td>
          </tr>
        <% } else { %>
          <% users.forEach((user) => { %>
            <tr>
              <td>
                <div class="user-cell">
                  <div class="u-avatar"><%= user.name ? user.name[0].toUpperCase() : '?' %></div>
                  <div>
                    <div class="u-name"><%= user.name || '—' %></div>
                  </div>
                </div>
              </td>
              <td>
                <div class="contact-cell">
                  <span class="contact-item"><i class="bi bi-envelope"></i> <%= user.email %></span>
                  <span class="contact-item"><i class="bi bi-telephone"></i> <%= user.phone || '—' %></span>
                </div>
              </td>
              <td style="color:#6b7280;">—</td>
              <td style="color:#6b7280;">—</td>
              <td style="color:#6b7280;">
                <%= new Date(user.createdAt).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' }) %>
              </td>
              <td>
                <% if (user.isBlocked) { %>
                  <span class="badge badge-blocked">Blocked</span>
                <% } else { %>
                  <span class="badge badge-active">Active</span>
                <% } %>
              </td>
              <td>
                <div class="action-btns">
                  <button class="action-btn" title="Edit" style="pointer-events:none;opacity:0.35;"><i class="bi bi-pencil-square"></i></button>
                  <button
                    class="action-btn <%= user.isBlocked ? 'unblock-btn' : 'block-btn' %>"
                    title="<%= user.isBlocked ? 'Unblock' : 'Block' %>"
                    onclick="openConfirm('<%= user._id %>', '<%= (user.name || user.email).replace(/'/g, "\\'") %>', '<%= user.isBlocked %>')"
                  >
                    <i class="bi bi-slash-circle"></i>
                  </button>
                  <button class="action-btn" title="Delete" style="pointer-events:none;opacity:0.35;"><i class="bi bi-trash3"></i></button>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Pagination -->
  <% if (totalPages > 1) { %>
    <div class="pagination-bar">
      <span class="page-info">
        Showing <%= (currentPage - 1) * 5 + 1 %> to <%= Math.min(currentPage * 5, users.length + (currentPage - 1) * 5) %> entries
      </span>
      <div class="page-btns">
        <a
          href="/admin/users?page=<%= currentPage - 1 %>&search=<%= search %>"
          class="page-btn <%= currentPage === 1 ? 'disabled' : '' %>"
        ><i class="bi bi-chevron-left"></i></a>

        <% for (let p = 1; p <= totalPages; p++) { %>
          <a
            href="/admin/users?page=<%= p %>&search=<%= search %>"
            class="page-btn <%= p === currentPage ? 'active' : '' %>"
          ><%= p %></a>
        <% } %>

        <a
          href="/admin/users?page=<%= currentPage + 1 %>&search=<%= search %>"
          class="page-btn <%= currentPage === totalPages ? 'disabled' : '' %>"
        ><i class="bi bi-chevron-right"></i></a>
      </div>
    </div>
  <% } %>

</div>

<!-- Confirm Modal -->
<div class="modal-overlay" id="confirmModal">
  <div class="modal">
    <div class="modal-icon" id="modalIcon"><i class="bi" id="modalIconI"></i></div>
    <h3 id="modalTitle"></h3>
    <p id="modalDesc"></p>
    <div class="modal-actions">
      <button class="btn-modal-cancel" onclick="closeConfirm()">Cancel</button>
      <button class="btn-modal-confirm" id="confirmBtn" onclick="confirmToggle()">Confirm</button>
    </div>
  </div>
</div>

<!-- Toast -->
<div class="toast" id="toast"></div>

<script>
  let pendingUserId = null;

  function openConfirm(userId, userName, isBlockedStr) {
    const isBlocked = isBlockedStr === 'true';
    pendingUserId = userId;
    const icon  = document.getElementById('modalIcon');
    const iconI = document.getElementById('modalIconI');
    const title = document.getElementById('modalTitle');
    const desc  = document.getElementById('modalDesc');
    const btn   = document.getElementById('confirmBtn');

    if (isBlocked) {
      iconI.className = 'bi bi-person-check-fill';
      title.textContent = 'Unblock User';
      desc.textContent  = `Are you sure you want to unblock "${userName}"? They will regain access to the platform.`;
      btn.className   = 'btn-modal-confirm unblock';
      btn.textContent = 'Yes, Unblock';
    } else {
      icon.className  = 'modal-icon block';
      iconI.className = 'bi bi-person-slash-fill';
      title.textContent = 'Block User';
      desc.textContent  = `Are you sure you want to block "${userName}"? They will lose access to the platform.`;
      btn.className   = 'btn-modal-confirm block';
      btn.textContent = 'Yes, Block';
    }

    document.getElementById('confirmModal').classList.add('show');
  }

  function closeConfirm() {
    document.getElementById('confirmModal').classList.remove('show');
    pendingUserId = null;
  }

  async function confirmToggle() {
    if (!pendingUserId) return;
    try {
      const res = await axios.patch(`/admin/block-user/${pendingUserId}`);
      closeConfirm();
      showToast(res.data.message, 'success');
      setTimeout(() => location.reload(), 900);
    } catch (err) {
      closeConfirm();
      showToast(err.response?.data?.message || 'Something went wrong', 'error');
    }
  }

  function showToast(msg, type = 'success') {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.className = `toast toast-${type} show`;
    setTimeout(() => t.classList.remove('show'), 3000);
  }

  document.getElementById('confirmModal').addEventListener('click', function(e) {
    if (e.target === this) closeConfirm();
  });
</script>
