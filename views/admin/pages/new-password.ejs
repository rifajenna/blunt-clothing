<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Set New Password | Blunt Admin</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"/>
  <link rel="stylesheet" href="/admin/css/admin-auth.css"/>
</head>
<body>

  <div class="brand">
    <i class="brand-icon">🔒</i>
    <span class="brand-name">BLUNT Admin Panel</span>
  </div>

  <div class="card">
    <h2>Set New Password</h2>
    <p>Your new password must be different from previous passwords.</p>

    <div id="alertBox" class="alert"></div>

    <div class="form-group">
      <label for="password">New Password</label>
      <div class="input-wrap">
        <input type="password" id="password" placeholder="Enter new password"/>
        <button class="toggle-eye" onclick="toggleVisibility('password', this)" type="button">👁</button>
      </div>
      <div class="field-error" id="passwordError">Password must be at least 6 characters</div>
    </div>

    <div class="form-group">
      <label for="confirmPassword">Confirm New Password</label>
      <div class="input-wrap">
        <input type="password" id="confirmPassword" placeholder="Confirm your password"/>
        <button class="toggle-eye" onclick="toggleVisibility('confirmPassword', this)" type="button">👁</button>
      </div>
      <div class="field-error" id="confirmError">Passwords do not match</div>
    </div>

    <button class="btn" id="resetBtn">
      <span id="btnText">Reset Password</span>
      <div class="spinner" id="spinner"></div>
    </button>

    <a href="/admin/login" class="back-link">← Return to Sign In</a>
  </div>

<script>
  function toggleVisibility(fieldId, btn) {
    const input = document.getElementById(fieldId);
    input.type = input.type === 'password' ? 'text' : 'password';
    btn.textContent = input.type === 'password' ? '👁' : '🙈';
  }

  document.getElementById('resetBtn').addEventListener('click', async () => {
    const password = document.getElementById('password').value;
    const confirmPassword = document.getElementById('confirmPassword').value;

    // Reset errors
    ['password','confirmPassword'].forEach(id => {
      document.getElementById(id).classList.remove('error');
    });
    document.getElementById('passwordError').classList.remove('show');
    document.getElementById('confirmError').classList.remove('show');
    document.getElementById('alertBox').classList.remove('show');

    let valid = true;

    if (!password || password.length < 6) {
      document.getElementById('password').classList.add('error');
      document.getElementById('passwordError').classList.add('show');
      valid = false;
    }

    if (!confirmPassword || confirmPassword !== password) {
      document.getElementById('confirmPassword').classList.add('error');
      document.getElementById('confirmError').classList.add('show');
      valid = false;
    }

    if (!valid) return;

    setLoading(true);

    try {
      const res = await axios.post('/admin/new-password', { password, confirmPassword });
      showAlert(res.data.message, 'success');
      setTimeout(() => window.location.href = res.data.redirectUrl, 1000);
    } catch (err) {
      showAlert(err.response?.data?.message || 'Something went wrong');
    } finally {
      setLoading(false);
    }
  });

  function setLoading(val) {
    document.getElementById('resetBtn').disabled = val;
    document.getElementById('btnText').textContent = val ? 'Resetting...' : 'Reset Password';
    document.getElementById('spinner').classList.toggle('show', val);
  }

  function showAlert(msg, type = 'error') {
    const box = document.getElementById('alertBox');
    box.textContent = msg;
    box.className = `alert alert-${type} show`;
  }
</script>
</body>
</html>
