<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %> | Blunt Admin</title>

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>

  <% if (locals.cssFile) { %>
    <link rel="stylesheet" href="/admin/css/<%= cssFile %>"/>
  <% } %>

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --sidebar-bg: #111827;
      --sidebar-hover: rgba(255,255,255,0.07);
      --sidebar-active: rgba(255,255,255,0.1);
      --sidebar-text: #9ca3af;
      --sidebar-text-active: #ffffff;
      --sidebar-w: 220px;
      --topbar-h: 64px;
      --content-bg: #f3f4f6;
      --card-bg: #ffffff;
      --border: #e5e7eb;
      --text: #111827;
      --text-muted: #6b7280;
      --danger: #ef4444;
      --success: #10b981;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--content-bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
    }

    /* ── Sidebar ── */
    .sidebar {
      width: var(--sidebar-w);
      background: var(--sidebar-bg);
      display: flex;
      flex-direction: column;
      position: fixed;
      top: 0; left: 0;
      height: 100vh;
      z-index: 100;
    }

    .sidebar-brand {
      padding: 18px 16px;
      display: flex;
      align-items: center;
      gap: 10px;
      border-bottom: 1px solid rgba(255,255,255,0.07);
    }

    .brand-icon {
      width: 34px; height: 34px;
      background: #ffffff;
      color: #111827;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 0.8rem;
      flex-shrink: 0;
    }

    .brand-name {
      font-size: 1rem;
      font-weight: 700;
      color: #ffffff;
      letter-spacing: 1.5px;
    }

    .sidebar-nav {
      padding: 12px 10px;
      flex: 1;
      overflow-y: auto;
    }

    .nav-section-label {
      font-size: 0.62rem;
      font-weight: 600;
      color: #4b5563;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      padding: 12px 10px 5px;
    }

    .nav-link {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 9px 12px;
      border-radius: 7px;
      color: var(--sidebar-text);
      text-decoration: none;
      font-size: 0.875rem;
      font-weight: 500;
      transition: background 0.18s, color 0.18s, transform 0.12s;
      position: relative;
      margin-bottom: 1px;
    }

    .nav-link:hover {
      background: var(--sidebar-hover);
      color: #e5e7eb;
      transform: translateX(2px);
    }

    .nav-link.active {
      background: var(--sidebar-active);
      color: var(--sidebar-text-active);
    }

    .nav-link.active::before {
      content: '';
      position: absolute;
      left: 0; top: 7px; bottom: 7px;
      width: 3px;
      background: #ffffff;
      border-radius: 0 3px 3px 0;
    }

    .nav-link i {
      font-size: 0.95rem;
      width: 18px;
      text-align: center;
      flex-shrink: 0;
    }

    .nav-link.dummy {
      pointer-events: none;
      opacity: 0.38;
      cursor: default;
    }

    .sidebar-footer {
      padding: 12px 10px;
      border-top: 1px solid rgba(255,255,255,0.07);
    }

    .logout-btn {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 12px;
      border-radius: 7px;
      color: #ffffff;
      background: var(--danger);
      text-decoration: none;
      font-size: 0.875rem;
      font-weight: 600;
      transition: opacity 0.15s;
      width: 100%;
    }

    .logout-btn:hover { opacity: 0.85; }

    /* ── Main ── */
    .main-wrap {
      margin-left: var(--sidebar-w);
      flex: 1;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }

    /* ── Topbar ── */
    .topbar {
      background: var(--card-bg);
      border-bottom: 1px solid var(--border);
      padding: 0 28px;
      height: var(--topbar-h);
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .topbar-search {
      flex: 1;
      max-width: 440px;
    }

    .topbar-search input {
      width: 100%;
      background: #f9fafb;
      border: 1.5px solid var(--border);
      border-radius: 8px;
      padding: 9px 16px;
      font-family: 'Inter', sans-serif;
      font-size: 0.875rem;
      color: var(--text);
      outline: none;
      transition: border-color 0.15s;
    }

    .topbar-search input:focus { border-color: #9ca3af; }
    .topbar-search input::placeholder { color: #9ca3af; }

    .topbar-right {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .notif-btn {
      position: relative;
      width: 36px; height: 36px;
      border-radius: 50%;
      border: 1.5px solid var(--border);
      background: transparent;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer;
      color: var(--text-muted);
      font-size: 1rem;
      transition: border-color 0.15s, background 0.15s;
    }

    .notif-btn:hover { border-color: #9ca3af; background: #f9fafb; }

    .notif-dot {
      position: absolute;
      top: 5px; right: 5px;
      width: 7px; height: 7px;
      background: var(--danger);
      border-radius: 50%;
      border: 2px solid white;
    }

    .topbar-user {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .topbar-user-info { text-align: right; }
    .topbar-user-name { font-size: 0.875rem; font-weight: 600; color: var(--text); }
    .topbar-user-role { font-size: 0.72rem; color: var(--text-muted); }

    .topbar-avatar {
      width: 36px; height: 36px;
      border-radius: 50%;
      background: #e5e7eb;
      border: 1.5px solid var(--border);
      display: flex; align-items: center; justify-content: center;
      color: var(--text-muted);
      font-size: 1rem;
    }

    /* ── Page ── */
    .page-content {
      padding: 28px;
      flex: 1;
    }
  </style>
</head>
<body>

<% if (locals.showLayout) { %>

  <!-- Sidebar -->
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="brand-icon">.B</div>
      <span class="brand-name">BLUNT</span>
    </div>

    <nav class="sidebar-nav">

      <a href="/admin/dashboard" class="nav-link <%= locals.title === 'Dashboard' ? 'active' : '' %>">
        <i class="bi bi-grid-1x2-fill"></i> Dashboard
      </a>

      <a href="/admin/users" class="nav-link <%= locals.title === 'Users' ? 'active' : '' %>">
        <i class="bi bi-people-fill"></i> Users
      </a>

      <div class="nav-section-label">Store</div>

      <span class="nav-link dummy"><i class="bi bi-box-seam-fill"></i> Products</span>
      <a href="/admin/categories" class="nav-link <%= locals.title === 'Categories' ? 'active' : '' %>">
        <i class="bi bi-tag-fill"></i> Categories
      </a>
      <span class="nav-link dummy"><i class="bi bi-percent"></i> Offers</span>

      <div class="nav-section-label">Operations</div>

      <span class="nav-link dummy"><i class="bi bi-bag-fill"></i> Orders</span>
      <span class="nav-link dummy"><i class="bi bi-credit-card-fill"></i> Payments</span>
      <span class="nav-link dummy"><i class="bi bi-arrow-return-left"></i> Refunds</span>
      <span class="nav-link dummy"><i class="bi bi-star-fill"></i> Review/Rating</span>

    </nav>

    <div class="sidebar-footer">
      <a href="/admin/logout" class="logout-btn">
        <i class="bi bi-box-arrow-left"></i> Logout
      </a>
    </div>
  </aside>

  <!-- Main -->
  <div class="main-wrap">
    <header class="topbar">
      <div class="topbar-search">
        <input type="text" placeholder="Search orders, products..."/>
      </div>
      <div class="topbar-right">
        <button class="notif-btn">
          <i class="bi bi-bell"></i>
          <span class="notif-dot"></span>
        </button>
        <div class="topbar-user">
          <div class="topbar-user-info">
            <div class="topbar-user-name">John Doe</div>
            <div class="topbar-user-role">Admin</div>
          </div>
          <div class="topbar-avatar">
            <i class="bi bi-person-fill"></i>
          </div>
        </div>
      </div>
    </header>

    <main class="page-content">
      <%- body %>
    </main>
  </div>

<% } else { %>
  <%- body %>
<% } %>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

<% if (locals.pageJS && pageJS !== '') { %>
  <script src="/admin/js/<%= pageJS %>"></script>
<% } %>

</body>
</html>
