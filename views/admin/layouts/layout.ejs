<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %> | Blunt Admin</title>

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>

  <link rel="stylesheet" href="/admin/css/admin-layout.css"/>
  <link rel="stylesheet" href="/admin/css/admin-common.css"/>

  <% if (locals.cssFile) { %>
    <link rel="stylesheet" href="/admin/css/<%= cssFile %>"/>
  <% } %>
</head>
<body>

<% if (locals.showLayout) { %>

  <!-- Sidebar -->
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="brand-icon">.B</div>
      <span class="brand-name">BLUNT</span>
    </div>

    <nav class="sidebar-nav">

      <a href="/admin/dashboard" class="nav-link <%= locals.title === 'Dashboard' ? 'active' : '' %>">
        <i class="bi bi-grid-1x2-fill"></i> Dashboard
      </a>

      <a href="/admin/users" class="nav-link <%= locals.title === 'Users' ? 'active' : '' %>">
        <i class="bi bi-people-fill"></i> Users
      </a>

      <div class="nav-section-label">Store</div>

      <a href="/admin/products" class="nav-link <%= locals.title === 'Products' || locals.title === 'Add Product' || locals.title === 'Edit Product' ? 'active' : '' %>">
        <i class="bi bi-box-seam-fill"></i> Products
      </a>
      <a href="/admin/categories" class="nav-link <%= locals.title === 'Categories' ? 'active' : '' %>">
        <i class="bi bi-tag-fill"></i> Categories
      </a>
      <span class="nav-link dummy"><i class="bi bi-percent"></i> Offers</span>

      <div class="nav-section-label">Operations</div>

      <span class="nav-link dummy"><i class="bi bi-bag-fill"></i> Orders</span>
      <span class="nav-link dummy"><i class="bi bi-credit-card-fill"></i> Payments</span>
      <span class="nav-link dummy"><i class="bi bi-arrow-return-left"></i> Refunds</span>
      <span class="nav-link dummy"><i class="bi bi-star-fill"></i> Review/Rating</span>

    </nav>

    <div class="sidebar-footer">
      <a href="/admin/logout" class="logout-btn">
        <i class="bi bi-box-arrow-left"></i> Logout
      </a>
    </div>
  </aside>

  <!-- Main -->
  <div class="main-wrap">
    <header class="topbar">
      <div class="topbar-search">
        <input type="text" placeholder="Search orders, products..."/>
      </div>
      <div class="topbar-right">
        <button class="notif-btn">
          <i class="bi bi-bell"></i>
          <span class="notif-dot"></span>
        </button>
        <div class="topbar-user">
          <div class="topbar-user-info">
            <div class="topbar-user-name">John Doe</div>
            <div class="topbar-user-role">Admin</div>
          </div>
          <div class="topbar-avatar">
            <i class="bi bi-person-fill"></i>
          </div>
        </div>
      </div>
    </header>

    <main class="page-content">
      <%- body %>
    </main>
  </div>

<% } else { %>
  <%- body %>
<% } %>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

<% if (locals.pageJS && pageJS !== '') { %>
  <script src="/admin/js/<%= pageJS %>"></script>
<% } %>

</body>
</html>
