<%- include('partials/header', { title: 'Reset Password — BLUNT', cssFile: 'auth.css' }) %>

<div class="auth-wrap">
  <div class="auth-card">
    <div class="auth-brand"><h1>BLUNT</h1><p>My Account</p></div>
    <div id="alertBox" class="alert"></div>
    <h2 class="auth-title">Reset Password</h2>
    <p class="auth-subtitle">Enter your new password below to complete the reset.</p>

    <div class="form-group">
      <label for="password">New Password</label>
      <div class="input-wrap">
        <input type="password" id="password" placeholder="Enter new password"/>
        <button type="button" class="toggle-eye" onclick="togglePass('password', this)"><i class="bi bi-eye"></i></button>
      </div>
      <div class="field-error" id="passwordError">Password must be at least 6 characters</div>
    </div>

    <div class="form-group">
      <label for="confirmPassword">Confirm Password</label>
      <div class="input-wrap">
        <input type="password" id="confirmPassword" placeholder="Confirm new password"/>
        <button type="button" class="toggle-eye" onclick="togglePass('confirmPassword', this)"><i class="bi bi-eye"></i></button>
      </div>
      <div class="field-error" id="confirmPasswordError">Passwords do not match</div>
    </div>

    <button class="btn-primary" id="resetBtn">
      <span id="btnText">Reset Password</span>
      <div class="spinner" id="spinner"></div>
    </button>

    <div class="auth-footer"><a href="/user/login">← Back to Login</a></div>
  </div>
</div>

<script>
  function togglePass(id, btn) {
    const input = document.getElementById(id);
    const icon = btn.querySelector('i');
    input.type = input.type === 'password' ? 'text' : 'password';
    icon.className = input.type === 'password' ? 'bi bi-eye' : 'bi bi-eye-slash';
  }

  document.getElementById('resetBtn').addEventListener('click', async () => {
    const password = document.getElementById('password').value;
    const confirmPassword = document.getElementById('confirmPassword').value;
    ['password', 'confirmPassword'].forEach(f => {
      document.getElementById(f).classList.remove('error');
      document.getElementById(f + 'Error').classList.remove('show');
    });
    document.getElementById('alertBox').classList.remove('show');
    let valid = true;
    if (!password || password.length < 6) { document.getElementById('password').classList.add('error'); document.getElementById('passwordError').classList.add('show'); valid = false; }
    if (!confirmPassword || confirmPassword !== password) { document.getElementById('confirmPassword').classList.add('error'); document.getElementById('confirmPasswordError').classList.add('show'); valid = false; }
    if (!valid) return;
    setLoading(true);
    try {
      const res = await axios.post('/user/reset-password', { password });
      showAlert(res.data.message, 'success');
      setTimeout(() => window.location.href = res.data.redirectUrl, 800);
    } catch (err) {
      showAlert(err.response?.data?.message || 'Something went wrong');
    } finally { setLoading(false); }
  });

  function setLoading(val) {
    document.getElementById('resetBtn').disabled = val;
    document.getElementById('btnText').textContent = val ? 'Resetting...' : 'Reset Password';
    document.getElementById('spinner').classList.toggle('show', val);
  }

  function showAlert(msg, type = 'error') {
    const box = document.getElementById('alertBox');
    box.textContent = msg;
    box.className = `alert alert-${type} show`;
  }
</script>

<%- include('partials/footer') %>
