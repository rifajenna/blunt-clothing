<!DOCTYPE html>
<html lang="en">

<head>
<meta charset="UTF-8">
<title>Add Address</title>

<link rel="stylesheet" href="/user/css/layout.css">
<link rel="stylesheet" href="/user/css/profile.css">

<link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
</head>

<body>

<%- include('../partials/header') %>

<div class="profile-container">

<!-- SIDEBAR -->
<aside class="sidebar">

<div class="user-card">
<div class="avatar">
<i class="ri-user-line"></i>
</div>

<h3><%= user?.name %></h3>
<p><%= user?.email %></p>
</div>

<ul class="menu">

<li>
<a href="/user/profile">
<i class="ri-user-line"></i>
Personal Information
</a>
</li>

<li class="active">
<a href="/user/addresses">
<i class="ri-map-pin-line"></i>
Addresses
</a>
</li>

<li>
<i class="ri-heart-line"></i>
Wishlist
</li>

<li>
<i class="ri-bank-card-line"></i>
Payment Methods
</li>

<li>
<i class="ri-shopping-bag-line"></i>
Order History
</li>

<li class="logout">
<a href="/user/logout">
<i class="ri-logout-box-line"></i>
Logout
</a>
</li>

</ul>

</aside>


<!-- MAIN CONTENT -->
<main class="content">

<div class="card">

<h2>Add New Address</h2>

<form action="/user/add-address" method="POST" class="address-form">

<div class="form-group">
<label>Full Name *</label>
<input type="text" name="name" placeholder="Enter your full name" required>
</div>

<div class="form-group">
<label>Phone Number *</label>
<input type="text" name="phone" placeholder="Enter your phone number" required>
</div>

<div class="form-group">
<label>Address Line 1 *</label>
<input type="text" name="house" placeholder="Street address, P.O box">
</div>

<div class="form-group">
<label>Address Line 2</label>
<input type="text" name="area" placeholder="Apartment, suite, building">
</div>

<div class="form-row">

<div class="form-group">
<label>City *</label>
<input type="text" name="city" placeholder="City">
</div>

<div class="form-group">
<label>State *</label>
<input type="text" name="state" placeholder="State">
</div>

</div>

<div class="form-row">

<div class="form-group">
<label>ZIP Code *</label>
<input type="text" name="pincode" placeholder="ZIP Code">
</div>

<div class="form-group">
<label>Type</label>
<select name="type">
<option value="Home">Home</option>
<option value="Work">Work</option>
</select>
</div>

</div>

<div class="form-actions">

<button type="submit" class="save-btn">Save Address</button>

<a href="/user/addresses" class="cancel-btn">Cancel</a>

</div>

</form>

</div>

</main>

</div>

<%- include('../partials/footer') %>

</body>
</html>