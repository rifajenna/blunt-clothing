<!DOCTYPE html>
<html lang="en">

<head>
<meta charset="UTF-8">
<title>Edit Address</title>

<link rel="stylesheet" href="/user/css/layout.css">
<link rel="stylesheet" href="/user/css/profile.css">

<link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
</head>

<body>

<%- include('../partials/header') %>

<div class="profile-container">

<!-- SIDEBAR -->
<aside class="sidebar">

<div class="user-card">
<div class="avatar">
<i class="ri-user-line"></i>
</div>

<h3><%= user?.name %></h3>
<p><%= user?.email %></p>
</div>

<ul class="menu">

<li>
<a href="/user/profile">
<i class="ri-user-line"></i>
Personal Information
</a>
</li>

<li class="active">
<a href="/user/addresses">
<i class="ri-map-pin-line"></i>
Addresses
</a>
</li>

<li class="logout">
<a href="/user/logout">
<i class="ri-logout-box-line"></i>
Logout
</a>
</li>

</ul>

</aside>

<!-- MAIN CONTENT -->
<main class="content">

<div class="card">

<h2>Edit Address</h2>

<form action="/user/edit-address/<%= address._id %>" method="POST" class="address-form">

<div class="form-group">
<label>Full Name</label>
<input type="text" name="name" value="<%= address.name %>">
</div>

<div class="form-group">
<label>Phone</label>
<input type="text" name="phone" value="<%= address.phone %>">
</div>

<div class="form-group">
<label>House</label>
<input type="text" name="house" value="<%= address.house %>">
</div>

<div class="form-group">
<label>Area</label>
<input type="text" name="area" value="<%= address.area %>">
</div>

<div class="form-row">

<div class="form-group">
<label>City</label>
<input type="text" name="city" value="<%= address.city %>">
</div>

<div class="form-group">
<label>State</label>
<input type="text" name="state" value="<%= address.state %>">
</div>

</div>

<div class="form-group">
<label>Pincode</label>
<input type="text" name="pincode" value="<%= address.pincode %>">
</div>

<div class="form-actions">

<button type="submit" class="save-btn">Update Address</button>

<a href="/user/addresses" class="cancel-btn">Cancel</a>

</div>

</form>

</div>

</main>

</div>

<%- include('../partials/footer') %>

</body>
</html>