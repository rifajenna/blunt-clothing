<!DOCTYPE html>
<html lang="en">

<head>
<meta charset="UTF-8">
<title>Forgot Password</title>

<link rel="stylesheet" href="/user/css/layout.css">
<link rel="stylesheet" href="/user/css/user-login.css">

<link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
</head>

<body>

<%- include('../partials/header') %>

<div class="auth-container">

<div class="auth-card">

<h2>Reset Password</h2>

<p class="auth-desc">
Lost your password? Please enter your email address.
You will receive an OTP to create a new password via email.
</p>

<form action="/user/forgot-password" method="POST">

<label>Email address *</label>
<input type="email" name="email" required>

<button type="submit" class="auth-btn">
Reset Password
</button>

</form>

<div class="auth-footer">
Remember your password?
<a href="/user/login">Back to Login</a>
</div>

</div>

</div>

<%- include('../partials/footer') %>

</body>
</html>