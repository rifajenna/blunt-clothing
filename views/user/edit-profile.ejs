<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit Profile</title>
  <link rel="stylesheet" href="/user/css/layout.css">
  <link rel="stylesheet" href="/user/css/profile.css">
  <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
  <style>
    .edit-container { max-width:600px; margin:60px auto; background:white; padding:40px; border-radius:10px; box-shadow:0 5px 20px rgba(0,0,0,0.1); }
    .edit-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:30px; }
    .edit-header h2 { font-size:22px; }
    .profile-pic { text-align:center; margin-bottom:25px; }
    .profile-pic img { width:90px; height:90px; border-radius:50%; object-fit:cover; border:3px solid #eee; }
    .form-group { margin-bottom:20px; }
    .form-group label { display:block; font-size:14px; margin-bottom:6px; color:#666; }
    .form-group input { width:100%; padding:10px; border:1px solid #ddd; border-radius:6px; font-size:14px; box-sizing:border-box; }
    .form-row { display:flex; gap:20px; }
    .buttons { display:flex; gap:15px; margin-top:20px; }
    .btn-save { background:black; color:white; padding:10px 18px; border:none; border-radius:6px; cursor:pointer; }
    .btn-cancel { padding:10px 18px; border:1px solid #ccc; border-radius:6px; text-decoration:none; color:#333; }
    .alert { padding:10px; border-radius:6px; margin-bottom:16px; display:none; font-size:14px; }
    .alert.show { display:block; }
  </style>
</head>
<body>

<%- include('partials/header') %>

<div class="edit-container">
  <div class="edit-header">
    <h2>Edit Personal Information</h2>
    <a href="/user/profile"><i class="ri-close-line"></i></a>
  </div>

  <div class="profile-pic">
    <img src="<%= user.profileImage || '/images/default-user.png' %>" alt="profile">
  </div>

  <div id="alertBox" class="alert"></div>

  <div class="form-row">
    <div class="form-group">
      <label>Full Name</label>
      <input type="text" id="name" value="<%= user.name %>" required>
    </div>
    <div class="form-group">
      <label>Email</label>
      <input type="email" value="<%= user.email %>" disabled>
    </div>
  </div>

  <div class="form-group">
    <label>Phone Number</label>
    <input type="text" id="phone" value="<%= user.phone || '' %>">
  </div>

  <div class="buttons">
    <button class="btn-save" onclick="handleUpdate()">Save Changes</button>
    <a class="btn-cancel" href="/user/profile">Cancel</a>
  </div>
</div>

<%- include('partials/footer') %>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script>
  function showAlert(message, type = "error") {
    const box = document.getElementById("alertBox");
    box.textContent = message;
    box.className = `alert show`;
    box.style.color = type === "error" ? "red" : "green";
  }

  async function handleUpdate() {
    const name = document.getElementById("name").value.trim();
    const phone = document.getElementById("phone").value.trim();

    if (!name) return showAlert("Name is required.");

    try {
      const { data } = await axios.post("/user/edit-profile", { name, phone });

      if (data.redirectUrl) {
        window.location.href = data.redirectUrl;
      } else {
        showAlert(data.message || "Something went wrong.");
      }

    } catch (err) {
      const msg = err.response?.data?.message || "Something went wrong.";
      showAlert(msg);
    }
  }
  
</script>
</body>
</html>