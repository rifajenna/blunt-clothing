<%- include('partials/header', { title: 'Sign Up — BLUNT', cssFile: 'auth.css' }) %>

<div class="auth-wrap">
  <div class="auth-card">
    <div class="auth-brand">
      <h1>BLUNT</h1>
      <p>My Account</p>
    </div>

    <div id="alertBox" class="alert"></div>

    <h2 class="auth-title">Register</h2>
    <p class="auth-subtitle">Create your account to get started.</p>

    <div class="form-group">
      <label for="name">Full Name</label>
      <div class="input-wrap">
        <input type="text" id="name" placeholder="Enter your full name"/>
      </div>
      <div class="field-error" id="nameError">Name is required</div>
    </div>

    <div class="form-group">
      <label for="email">Email Address</label>
      <div class="input-wrap">
        <input type="email" id="email" placeholder="Enter your email"/>
      </div>
      <div class="field-error" id="emailError">Enter a valid email</div>
    </div>

    <div class="form-group">
      <label for="password">Password</label>
      <div class="input-wrap">
        <input type="password" id="password" placeholder="Create a password" oninput="checkStrength(this.value)"/>
        <button type="button" class="toggle-eye" onclick="togglePass('password', this)">
          <i class="bi bi-eye"></i>
        </button>
      </div>
      <div class="password-strength">
        <div class="strength-bar"><div class="strength-fill" id="strengthFill"></div></div>
        <span class="strength-text" id="strengthText"></span>
      </div>
      <div class="field-error" id="passwordError">Password must be at least 6 characters</div>
    </div>

    <div class="form-group">
      <label for="confirmPassword">Confirm Password</label>
      <div class="input-wrap">
        <input type="password" id="confirmPassword" placeholder="Confirm your password"/>
        <button type="button" class="toggle-eye" onclick="togglePass('confirmPassword', this)">
          <i class="bi bi-eye"></i>
        </button>
      </div>
      <div class="field-error" id="confirmPasswordError">Passwords do not match</div>
    </div>

    <button class="btn-primary" id="signupBtn">
      <span id="btnText">Create Account</span>
      <div class="spinner" id="spinner"></div>
    </button>

    <div class="divider">or</div>

    <a href="/user/auth/google" class="btn-google">
      <svg width="18" height="18" viewBox="0 0 48 48">
        <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
        <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
        <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
        <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
      </svg>
      Continue with Google
    </a>

    <div class="auth-footer">
      Already have an account? <a href="/user/login">Sign in</a>
    </div>
  </div>
</div>

<script>
  function togglePass(id, btn) {
    const input = document.getElementById(id);
    const icon = btn.querySelector('i');
    input.type = input.type === 'password' ? 'text' : 'password';
    icon.className = input.type === 'password' ? 'bi bi-eye' : 'bi bi-eye-slash';
  }

  function checkStrength(val) {
    const fill = document.getElementById('strengthFill');
    const text = document.getElementById('strengthText');
    if (!val) { fill.style.width = '0'; text.textContent = ''; return; }
    let score = 0;
    if (val.length >= 6) score++;
    if (val.length >= 10) score++;
    if (/[A-Z]/.test(val)) score++;
    if (/[0-9]/.test(val)) score++;
    if (/[^A-Za-z0-9]/.test(val)) score++;
    const levels = [
      { w: '20%', c: '#e53e3e', t: 'Too weak' },
      { w: '40%', c: '#dd6b20', t: 'Weak' },
      { w: '60%', c: '#d69e2e', t: 'Fair' },
      { w: '80%', c: '#38a169', t: 'Good' },
      { w: '100%', c: '#2f855a', t: 'Strong' },
    ];
    const l = levels[Math.min(score - 1, 4)] || levels[0];
    fill.style.width = l.w;
    fill.style.background = l.c;
    text.textContent = l.t;
    text.style.color = l.c;
  }

  document.getElementById('signupBtn').addEventListener('click', async () => {
    const name = document.getElementById('name').value.trim();
    const email = document.getElementById('email').value.trim();
    const password = document.getElementById('password').value;
    const confirmPassword = document.getElementById('confirmPassword').value;
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    clearErrors();
    let valid = true;
    if (!name) { showFieldError('name'); valid = false; }
    if (!email || !emailRegex.test(email)) { showFieldError('email'); valid = false; }
    if (!password || password.length < 6) { showFieldError('password'); valid = false; }
    if (password !== confirmPassword) { showFieldError('confirmPassword'); valid = false; }
    if (!valid) return;
    setLoading(true);
    try {
      const res = await axios.post('/user/signup', { name, email, password });
      showAlert(res.data.message, 'success');
      setTimeout(() => window.location.href = res.data.redirectUrl, 800);
    } catch (err) {
      showAlert(err.response?.data?.message || 'Something went wrong');
    } finally { setLoading(false); }
  });

  function clearErrors() {
    ['name', 'email', 'password', 'confirmPassword'].forEach(f => {
      document.getElementById(f).classList.remove('error');
      document.getElementById(f + 'Error').classList.remove('show');
    });
    document.getElementById('alertBox').classList.remove('show');
  }

  function showFieldError(field) {
    document.getElementById(field).classList.add('error');
    document.getElementById(field + 'Error').classList.add('show');
  }

  function setLoading(val) {
    document.getElementById('signupBtn').disabled = val;
    document.getElementById('btnText').textContent = val ? 'Creating account...' : 'Create Account';
    document.getElementById('spinner').classList.toggle('show', val);
  }

  function showAlert(msg, type = 'error') {
    const box = document.getElementById('alertBox');
    box.textContent = msg;
    box.className = `alert alert-${type} show`;
  }
</script>

<%- include('partials/footer') %>
