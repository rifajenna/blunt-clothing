<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BLUNT | Urban Essentials</title>
  <link rel="stylesheet" href="/user/css/layout.css">
  <link rel="stylesheet" href="/user/css/home.css">
  <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
</head>
<body>

  <nav class="navbar">
    <a href="/" class="nav-logo">BLUNT</a>
    <ul class="nav-links" style="display: flex; list-style: none; gap: 20px;">
      <li><a href="/shop">Shop</a></li>
      <li><a href="/about">About</a></li>
    </ul>
    <div class="nav-actions" style="margin-left: auto;">
      <% if (user) { %>
        <a href="/user/home" class="btn-login" style="border: 1px solid #000; padding: 5px 15px; border-radius: 4px; text-decoration: none; color: #000;">Dashboard</a>
      <% } else { %>
        <a href="/user/login" class="btn-login" style="border: 1px solid #000; padding: 5px 15px; border-radius: 4px; text-decoration: none; color: #000;">Sign In</a>
      <% } %>
    </div>
  </nav>

  <!-- HERO SECTION (FIGMA STYLE) -->
  <section class="hero-v2">
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <span class="edition-badge">Autumn | Winter '24 Edition</span>
      <h1>URBAN<br>ESSENTIALS</h1>
      <div class="hero-btns">
        <a href="/shop?category=Hoodies" class="btn btn-white">Shop Hoodies</a>
        <a href="/shop?category=Pants" class="btn btn-outline">Shop Pants</a>
      </div>
    </div>
  </section>

  <!-- CATEGORIES (OLD UI STYLE) -->
  <section class="categories">
    <h2>Shop By Category</h2>
    <div class="category-grid">
      <% if (categories && categories.length > 0) { %>
        <% categories.forEach(cat => { %>
          <div class="category-card" onclick="window.location.href='/shop?category=<%= cat._id %>'">
            <img src="<%= cat.image || '/images/default-cat.jpg' %>" alt="<%= cat.name %>">
            <div class="category-overlay">
              <h3><%= cat.name %></h3>
              <span>Explore Collection</span>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p>No categories available.</p>
      <% } %>
    </div>
  </section>

  <!-- FEATURED PRODUCTS (OLD UI STYLE) -->
  <section class="products">
    <h2>Featured Products</h2>
    <div class="product-grid">
      <% if (featuredProducts && featuredProducts.length > 0) { %>
        <% featuredProducts.forEach(product => { %>
          <div class="product-card">
            <div class="product-image-wrap" onclick="window.location.href='/shop/product/<%= product._id %>'">
              <img src="<%= product.images[0] %>" alt="<%= product.name %>">
              <% if (product.category) { %>
                <span class="badge-category"><%= product.category.name %></span>
              <% } %>
            </div>
            <div class="product-info">
              <h4><%= product.name %></h4>
              <p class="price">₹<%= product.price.toLocaleString() %></p>
              <button class="btn-add-cart" onclick="window.location.href='/user/login'">Add to Cart</button>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p>No featured products available.</p>
      <% } %>
    </div>
  </section>

  <footer style="background: #111827; color: #fff; padding: 80px 5%; text-align: center;">
    <h2 style="font-size: 2rem; margin-bottom: 20px;">BLUNT.</h2>
    <p style="opacity: 0.6; margin-bottom: 40px;">Premium streetwear for the bold.</p>
    <div style="display: flex; justify-content: center; gap: 40px;">
      <a href="#" style="color: #fff; text-decoration: none; opacity: 0.8;">Instagram</a>
      <a href="#" style="color: #fff; text-decoration: none; opacity: 0.8;">Twitter</a>
      <a href="#" style="color: #fff; text-decoration: none; opacity: 0.8;">Facebook</a>
    </div>
  </footer>

</body>
</html>
