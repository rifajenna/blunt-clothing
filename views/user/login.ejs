<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>User Login</title>
  <link rel="stylesheet" href="/user/css/user-login.css">
  <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
</head>

<body>

<!-- NAVBAR -->
<header class="navbar">
  <div class="nav-left">
    ☰
    <a href="#">Home</a>
    <a href="#">Shop</a>
  </div>

  <div class="nav-center">BLUNT</div>

  <div class="nav-right">
    🔍
    👤
    🛒
  </div>
</header>

<!-- MAIN -->
<div class="main">

  <h2>My Account</h2>

  <div class="login-card">

    <h3>Login</h3>

    <form method="POST" action="/user/login">

      <label>Email address *</label>
      <input type="email" name="email" required>

      <label>Password *</label>

<div class="password-field">

<input type="password" name="password" id="password" required>

<i class="ri-eye-line toggle-password"></i>

</div>

      <div class="options">
        <label>
          <input type="checkbox"> Remember me
        </label>
        <a href="/user/forgot-password">Forgot password?</a>
      </div>

      <button class="login-btn">Login</button>

    </form>

    <div class="divider">Or continue with</div>

    <div class="social">
      <button>Google</button>
    </div>

    <p class="register">
      Don’t have an account?
      <a href="/user/signup">Register here</a>
    </p>

  </div>

</div>

<!-- FOOTER -->
<footer class="footer">
  <div>
    <p>Your destination for Streetwears and apparels.</p>
  </div>

  <div>
    <h4>Support</h4>
    <p>My Account</p>
    <p>Order & Return</p>
    <p>Track Order</p>
  </div>

  <div>
    <h4>About Us</h4>
    <p>Story</p>
    <p>Principles</p>
    <p>FAQs</p>
  </div>

  <div>
    <h4>Guidance</h4>
    <p>Contact</p>
    <p>Privacy Policy</p>
    <p>Terms & Conditions</p>
  </div>
</footer>

<script>

const toggle = document.querySelector(".toggle-password")
const password = document.getElementById("password")

toggle.addEventListener("click",()=>{

if(password.type === "password"){
password.type = "text"
toggle.classList.replace("ri-eye-line","ri-eye-off-line")
}else{
password.type = "password"
toggle.classList.replace("ri-eye-off-line","ri-eye-line")
}

})

</script>

</body>
</html>