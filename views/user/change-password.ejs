<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Change Password</title>
  <link rel="stylesheet" href="/user/css/layout.css">
  <link rel="stylesheet" href="/user/css/profile.css">
  <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
  <style>
    .change-pass-container { max-width:450px; margin:80px auto; background:white; padding:40px; border-radius:10px; box-shadow:0 8px 25px rgba(0,0,0,0.1); }
    .change-pass-container h2 { text-align:center; margin-bottom:30px; }
    .form-group { margin-bottom:20px; }
    .form-group label { display:block; font-size:14px; margin-bottom:6px; color:#666; }
    .form-group input { width:100%; padding:10px; border:1px solid #ddd; border-radius:6px; font-size:14px; box-sizing:border-box; }
    .btn-update { width:100%; padding:12px; background:black; color:white; border:none; border-radius:6px; font-size:15px; cursor:pointer; margin-top:10px; }
    .btn-update:hover { background:#222; }
    .back-link { display:block; text-align:center; margin-top:15px; font-size:14px; text-decoration:none; color:#666; }
    .back-link:hover { text-decoration:underline; }
    .alert { padding:10px; border-radius:6px; margin-bottom:16px; display:none; font-size:14px; }
    .alert.show { display:block; }
  </style>
</head>
<body>

<%- include('partials/header') %>

<div class="change-pass-container">
  <h2>Change Password</h2>

  <div id="alertBox" class="alert"></div>

  <div class="form-group">
    <label>Current Password</label>
    <input type="password" id="currentPassword" required>
  </div>

  <div class="form-group">
    <label>New Password</label>
    <input type="password" id="newPassword" required>
  </div>

  <button class="btn-update" onclick="handleChangePassword()">Update Password</button>

  <a href="/user/profile" class="back-link">Back to Profile</a>
</div>

<%- include('partials/footer') %>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script>
  function showAlert(message, type = "error") {
    const box = document.getElementById("alertBox");
    box.textContent = message;
    box.className = `alert show`;
    box.style.color = type === "error" ? "red" : "green";
  }

  async function handleChangePassword() {
    const currentPassword = document.getElementById("currentPassword").value;
    const newPassword = document.getElementById("newPassword").value;

    if (!currentPassword || !newPassword) return showAlert("All fields are required.");

    try {
      const { data } = await axios.post("/user/change-password", { currentPassword, newPassword });

      if (data.redirectUrl) {
        window.location.href = data.redirectUrl;
      } else {
        showAlert(data.message || "Something went wrong.");
      }

    } catch (err) {
      const msg = err.response?.data?.message || "Something went wrong.";
      showAlert(msg);
    }
  }
</script>
</body>
</html>